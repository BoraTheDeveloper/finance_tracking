{
  "expo": {
    "name": "Luy Khnom",
    "slug": "luy-khnom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/luy-khnom-icon-flat.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.luykhnom.app",
      "adaptiveIcon": {
        "backgroundColor": "#14171C",
        "foregroundImage": "./assets/luy-khnom-android-icon-foreground-flat.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/luy-khnom-favicon-flat.png"
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
